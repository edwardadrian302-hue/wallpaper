{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "青野壁纸",
  "version": "0.1.2",
  "identifier": "com.qingye.wallpaper",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "appDirectoriesOverride": "./data",
    "windows": [
      {
        "label": "main",
        "title": "青野 · 每一天，自然一点",
        "width": 1360,
        "height": 940,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#f7f8f5"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data: asset: http://asset.localhost https://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost blob: asset: http://asset.localhost https://asset.localhost; script-src 'self'; object-src 'none'; base-uri 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPLOCALDATA/library/images/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png"
    ],
    "publisher": "Qingye",
    "category": "Photography",
    "shortDescription": "每天遇见新风景的本地壁纸软件",
    "useLocalToolsDir": true,
    "resources": {
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../THIRD_PARTY_LICENSES.txt": "THIRD_PARTY_LICENSES.txt",
      "runtime/WebView2Loader.dll": "WebView2Loader.dll"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "startMenuFolder": "青野壁纸"
      }
    }
  }
}
