{
  "policy": "shared-system-tools",
  "node": "26.13.1",
  "npm": "12.2.2",
  "rust": "1.100.0",
  "rustToolchain": "stable-x86_64-pc-windows-gnu",
  "rustTarget": "x86_64-pc-windows-gnu",
  "compiler": {
    "name": "MSYS2 UCRT64",
    "gcc": "16.2.0",
    "packageVersion": "16.2.0-7",
    "binutils": "2.47",
    "discovery": "MSYS2_UCRT64_BIN or PATH"
  },
  "notes": "Versions record the validated environment. Setup uses current stable tools; normal builds never install or update global tools."
}
